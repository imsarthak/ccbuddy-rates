
# Local-only Senco app-id for verification (never commit)
.senco.env

# Local-only Cuelinks publisher API token (never commit)
.cuelinks.env

# Local-only residential proxy URL, credentials inside (never commit)
.proxy.env

# Watcher logs, local to whatever device is running it
logs/

# Local-only alert channel config, tokens inside (never commit), and the
# temporary copy wa-phone.mjs --setup writes before swapping it in
.notify.env
.notify.env.*.tmp

# The WhatsApp poster's per-window ledger: in the Actions cache, and on the
# watcher phone
.wa-ledger/
